# Copia este archivo como .env en el servidor y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# Dominio público de la app, sin https:// (ej. 3-85-120-44.sslip.io)
DOMAIN=

# Base de datos (el contenedor de MySQL crea este usuario la primera vez)
MYSQL_ROOT_PASSWORD=
DB_USER=foroluna
DB_PASSWORD=

# Secreto para firmar los tokens JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Zona horaria de la app
TZ=America/Bogota
